# Set these in Vercel > Project > Settings > Environment Variables. Never commit real values.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
OWNER_CHAT_ID=            # Meera's (or your) Telegram user id
NOTES_CHANNEL_ID=         # e.g. -100xxxxxxxxxx
SUPABASE_URL=
SUPABASE_KEY=             # publishable key; access is gated by DB_SECRET + row-level security
DB_SECRET=                # must match private.bot_config.secret in the database
WEBHOOK_SECRET=           # random string; Telegram sends it back on every webhook call
CRON_SECRET=              # random string; Vercel Cron sends it; also unlocks /api/setup and /api/health

# Optional
GEMINI_MODEL=gemini-flash-latest
DRAFT_DAYS=mon,wed,fri
MAX_PENDING_DRAFTS=3
ACK_CAPTURES=true
NEWS_ANGLE=true          # B1: search Google for a current, sourced news angle
AUTO_DRAFT=true          # draft as soon as a note is judged worth a post
TRIAGE_BATCH=8
TZ_OFFSET_MINUTES=330
